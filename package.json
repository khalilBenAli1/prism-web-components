{
  "name": "@khalilbenali/prism-web-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original Lit component library and interactive design workbench.",
  "license": "MIT",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "files": [
    "package",
    "README.md",
    "LICENSE"
  ],
  "types": "./package/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./package/components/index.d.ts",
      "import": "./package/prism.js"
    },
    "./tokens.css": {
      "types": "./package/tokens.d.ts",
      "default": "./package/tokens.css"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4191",
    "build": "npm run build:package && npm run test:consumer && vite build && node scripts/postbuild.mjs && npm run budget",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/package-assets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4191",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:package && tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
